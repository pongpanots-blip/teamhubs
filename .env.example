# Database
# Docker Compose default:
# DATABASE_URL="postgresql://introverthubs:introverthubs@localhost:5432/introverthubs?schema=public"
# Local Postgres (e.g. Postgres.app) example:
DATABASE_URL="postgresql://USER@localhost:5432/introverthubs?schema=public"

# Auth
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# Optional: the app's real canonical URL, e.g. for production. In dev, the
# server already trusts any http://localhost:* origin, so this can be left
# unset if the dev server's port isn't fixed/known ahead of time.
BETTER_AUTH_URL="http://localhost:3000"

# Gemini — all AI call sites go through src/lib/ai/model-client.ts
# Multiple keys, comma-separated: each is tried before falling back to the next key,
# then the next model. Only advances on a rate-limit/quota error.
GEMINI_API_KEYS=""
# Single-key fallback if GEMINI_API_KEYS is unset.
GEMINI_API_KEY=""
GEMINI_MODELS="gemini-3.6-flash,gemini-pro-latest"

# Embeddings: voyage | openai | local (local = deterministic hash vectors for offline smoke)
EMBEDDING_PROVIDER="local"
VOYAGE_API_KEY=""
OPENAI_API_KEY=""
EMBEDDING_DIMS=1536

# Optional team-level defaults (can also be set in Settings UI)
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_REPO=""
FIGMA_TOKEN=""
FIGMA_FILE_KEY=""

# Crypto for stored integration credentials
CREDENTIALS_SECRET="change-me-credentials-secret-32chars"

# Cosine-distance ceiling for a RAG chunk to be sent to Claude (0 = identical, 2 = opposite)
RAG_MAX_DISTANCE=0.5

# Where new team invites are announced. Accepts a Discord or a Google Chat
# incoming webhook — the host decides which format is sent. Leave empty to
# skip delivery; the PM then copies the invite link by hand.
INVITE_WEBHOOK_URL=""
