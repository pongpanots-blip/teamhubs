generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum TeamRole {
  pm
  ui
  backend
  mobile
  ai
}

/**
 * Which part of the system a sub-task covers. Null on a parent/container task.
 */
enum TaskComponent {
  ui
  backend
  mobile
  ai
}

enum TaskStatus {
  not_ready
  ready
  assigned
  working
  blocked
  review
  done
}

enum TaskPriority {
  p0
  p1
  p2
  p3
}

enum NotificationType {
  task_unblocked
  task_blocked
  task_assigned
  figma_ready
  missing_context
}

enum DocSource {
  upload
  repo
}

enum InviteStatus {
  pending
  accepted
  revoked
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]
  projectMemberships ProjectMembership[]
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  decisions          DecisionLog[]
  invitesSent        Invite[]            @relation("InviteSender")
  notifications      Notification[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Team {
  id            String                  @id @default(cuid())
  name          String
  slug          String                  @unique
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  memberships   Membership[]
  invites       Invite[]
  projects      Project[]
  tasks         Task[]
  docChunks     DocChunk[]
  docs          TeamDoc[]
  notifications Notification[]
  contextRuns   ContextRun[]
  credentials   IntegrationCredential[]
}

/// A distinct project/product a team works on. Task/docs/RAG/integration
/// credentials are scoped here so unrelated projects don't leak context
/// into each other's grilling sessions.
model Project {
  id          String                  @id @default(cuid())
  teamId      String
  name        String
  slug        String
  /// Bearer token used by the Figma plugin to push design status. Null until generated.
  pluginToken String?                 @unique
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  team        Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberships ProjectMembership[]
  tasks       Task[]
  docs        TeamDoc[]
  docChunks   DocChunk[]
  credentials IntegrationCredential[]
  notifications Notification[]
  contextRuns   ContextRun[]
  invites       Invite[]

  @@unique([teamId, slug])
}

/// Per-project role — separate from the team-wide Membership because a
/// user's functional role (ui/backend/mobile/ai) can differ per project.
model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      TeamRole @default(backend)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Membership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(backend)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Invite {
  id          String       @id @default(cuid())
  teamId      String
  /// Set when the invite also grants membership of one project. Null = team-only invite.
  projectId   String?
  email       String
  role        TeamRole     @default(backend)
  /// Role granted inside `projectId`. Null whenever `projectId` is null.
  projectRole TeamRole?
  token       String       @unique @default(cuid())
  status      InviteStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([teamId, email])
}

model Task {
  id                 String         @id @default(cuid())
  teamId             String
  projectId          String
  title              String
  /// Short summary / description
  description        String         @default("")
  /// Explicit requirement text (must not live only in PM's head)
  requirement        String         @default("")
  /// Dynamic business rules — open-ended JSON array, NOT fixed coupon columns
  businessRules      Json           @default("[]")
  status             TaskStatus     @default(not_ready)
  priority           TaskPriority   @default(p2)
  deadline           DateTime?
  /// Set only on a component sub-task created from a grilling session; null on the parent task
  component          TaskComponent?
  /// Parent task when this row is a sub-task; null for a top-level task
  parentId           String?
  /// Owner — assigned person; Assigned ≠ Working
  assigneeId         String?
  createdById        String
  acceptanceCriteria String         @default("")
  figmaUrl           String?
  /// Design is ready for implementation (not just linked)
  figmaReady         Boolean        @default(false)
  /// Figma file name, reported by the plugin
  figmaFile          String?
  /// Figma page name, reported by the plugin
  figmaPage          String?
  /// Figma frame/node name, reported by the plugin
  figmaFrame         String?
  githubIssueUrl     String?
  githubPrUrl        String?
  /// Related internal doc paths (e.g. knowledge/engineering.md)
  internalDocPaths   String[]       @default([])
  /// Explicit API / backend readiness for this task
  apiReady           Boolean        @default(false)
  designLinked       Boolean        @default(false)
  acPresent          Boolean        @default(false)
  rulesPresent       Boolean        @default(false)
  requirementPresent Boolean        @default(false)
  readinessScore     Int            @default(0)
  readinessNotes     String         @default("")
  engineStatus       String?
  lastContextRunId   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy     User             @relation("TaskCreator", fields: [createdById], references: [id])
  dependsOn     TaskDependency[] @relation("DependentTask")
  dependedBy    TaskDependency[] @relation("DependencyTask")
  contextRuns   ContextRun[]
  decisions     DecisionLog[]
  notifications Notification[]
  handoffDocs   TaskHandoff[]
  parent        Task?            @relation("TaskSubTasks", fields: [parentId], references: [id], onDelete: SetNull)
  subTasks      Task[]           @relation("TaskSubTasks")

  @@index([parentId])
  @@index([teamId, status])
  @@index([assigneeId])
  @@index([teamId, priority])
  @@index([projectId, status])
}

model DecisionLog {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  decision  String
  rationale String   @default("")
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model TaskDependency {
  id           String   @id @default(cuid())
  dependentId  String
  dependencyId String
  source       String   @default("manual") // manual | engine
  createdAt    DateTime @default(now())
  dependent    Task     @relation("DependentTask", fields: [dependentId], references: [id], onDelete: Cascade)
  dependency   Task     @relation("DependencyTask", fields: [dependencyId], references: [id], onDelete: Cascade)

  @@unique([dependentId, dependencyId])
}

model Notification {
  id        String           @id @default(cuid())
  teamId    String
  /// Project the notification belongs to — filters out people who left the project.
  projectId String
  /**
   * Recipient.
   */
  userId    String
  taskId    String?
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([teamId])
  @@index([projectId])
}

model TeamDoc {
  id        String    @id @default(cuid())
  teamId    String
  projectId String
  /**
   * Stable identifier used as DocChunk.sourcePath, e.g. "coupon.md".
   */
  path      String
  title     String?
  content   String
  source    DocSource @default(upload)
  sizeBytes Int
  indexedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([teamId])
}

model DocChunk {
  id         String                       @id @default(cuid())
  teamId     String
  projectId  String
  sourcePath String
  content    String
  chunkIndex Int
  metadata   Json?
  // Stored via raw SQL as vector(1536); Prisma keeps a float array mirror for upserts in app layer.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  team       Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project    Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // HNSW index on `embedding` (vector_cosine_ops) lives in migration
  // 20260830100000_docchunk_hnsw_index — Prisma cannot express it on an
  // Unsupported() column. Keep it when squashing migrations.
  @@unique([projectId, sourcePath, chunkIndex])
  @@index([teamId])
}

model ContextRun {
  id           String   @id @default(cuid())
  teamId       String
  projectId    String
  taskId       String?
  query        String
  contextPack  Json
  /**
   * Parsed Claude analysis — replayed by the cascade so re-evaluation needs no API call.
   */
  analysis     Json?
  claudeRaw    Json?
  engineOutput Json?
  error        String?
  createdAt    DateTime @default(now())
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([teamId, taskId])
  @@index([projectId])
}

model TaskHandoff {
  id        String   @id @default(cuid())
  taskId    String
  /**
   * e.g. "dev", "design", "qa"
   */
  role      String
  title     String
  /**
   * Markdown body
   */
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, role])
  @@index([taskId])
}

model IntegrationCredential {
  id        String   @id @default(cuid())
  teamId    String
  projectId String
  provider  String // github | figma
  payload   String // encrypted JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider])
}
