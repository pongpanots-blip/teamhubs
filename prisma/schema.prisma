generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum TeamRole {
  pm
  ui
  website
  backend
  mobile
  ai
}

/**
 * Which part of the system a sub-task covers. Null on a parent/container task.
 */
enum TaskComponent {
  ui
  website
  backend
  mobile
  ai
}

enum TaskStatus {
  not_ready
  ready
  assigned
  working
  blocked
  review
  done
}

enum TaskPriority {
  p0
  p1
  p2
  p3
}

enum NotificationType {
  task_unblocked
  task_blocked
  task_assigned
  figma_ready
  missing_context
}

enum DocSource {
  upload
  repo
}

enum InviteStatus {
  pending
  accepted
  revoked
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]
  projectMemberships ProjectMembership[]
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  decisions          DecisionLog[]
  invitesSent        Invite[]            @relation("InviteSender")
  notifications      Notification[]
  statusChanges      TaskStatusHistory[] @relation("StatusChangeAuthor")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Team {
  id            String                  @id @default(cuid())
  name          String
  slug          String                  @unique
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  memberships   Membership[]
  invites       Invite[]
  projects      Project[]
  tasks         Task[]
  docChunks     DocChunk[]
  docs          TeamDoc[]
  notifications Notification[]
  contextRuns   ContextRun[]
  credentials   IntegrationCredential[]
}

/// A distinct project/product a team works on. Task/docs/RAG/integration
/// credentials are scoped here so unrelated projects don't leak context
/// into each other's grilling sessions.
model Project {
  id            String                  @id @default(cuid())
  teamId        String
  name          String
  slug          String
  /// Bearer token used by the Figma plugin to push design status. Null until generated.
  pluginToken   String?                 @unique
  /// Short uppercase code used as the ticket key prefix (e.g. "CHK" -> CHK-142).
  keyPrefix     String                  @default("TASK")
  /// Next number to hand out for this project's tickets — incremented
  /// transactionally with task creation so numbers never repeat or skip.
  nextTaskNumber Int                    @default(1)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  team          Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberships   ProjectMembership[]
  tasks         Task[]
  docs          TeamDoc[]
  docChunks     DocChunk[]
  credentials   IntegrationCredential[]
  notifications Notification[]
  contextRuns   ContextRun[]
  invites       Invite[]
  sprints       Sprint[]
  flowSnapshots FlowSnapshot[]
  repositories  ProjectRepository[]
  figmaFiles    ProjectFigmaFile[]

  @@unique([teamId, slug])
}

/// A repo this project's code lives in — dev/AI needs to know which repo to
/// check commits/PRs against and push to, independent of any single task's
/// githubPrUrl (which only exists once a task has one).
model ProjectRepository {
  id            String   @id @default(cuid())
  projectId     String
  provider      String   @default("github")
  owner         String
  name          String
  defaultBranch String   @default("main")
  /// Set on a monorepo where this project owns only part of the tree, e.g. "apps/backend".
  pathPrefix    String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, owner, name, pathPrefix])
}

/// A Figma file this project's design lives in — lets a task without its own
/// figmaUrl yet still point at where the design should come from.
model ProjectFigmaFile {
  id        String   @id @default(cuid())
  projectId String
  /// The file key segment of the Figma URL.
  fileKey   String
  name      String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fileKey])
}

/// Per-project role — separate from the team-wide Membership because a
/// user's functional role (ui/backend/mobile/ai) can differ per project.
model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      TeamRole @default(backend)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Membership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(backend)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Invite {
  id          String       @id @default(cuid())
  teamId      String
  /// Set when the invite also grants membership of one project. Null = team-only invite.
  projectId   String?
  email       String
  role        TeamRole     @default(backend)
  /// Role granted inside `projectId`. Null whenever `projectId` is null.
  projectRole TeamRole?
  token       String       @unique @default(cuid())
  status      InviteStatus @default(pending)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([teamId, email])
}

model Task {
  id                 String         @id @default(cuid())
  teamId             String
  projectId          String
  title              String
  /// Short summary / description
  description        String         @default("")
  /// Explicit requirement text (must not live only in PM's head)
  requirement        String         @default("")
  /// Dynamic business rules — open-ended JSON array, NOT fixed coupon columns
  businessRules      Json           @default("[]")
  status             TaskStatus     @default(not_ready)
  priority           TaskPriority   @default(p2)
  /// Sequential per-project ticket number — combined with the project's
  /// keyPrefix this is the human-facing key (e.g. "CHK-142"). Null on tasks
  /// created before this existed.
  taskNumber         Int?
  deadline           DateTime?
  /// Set only on a component sub-task created from a grilling session; null on the parent task
  component          TaskComponent?
  /// Parent task when this row is a sub-task; null for a top-level task
  parentId           String?
  /// Owner — assigned person; Assigned ≠ Working
  assigneeId         String?
  createdById        String
  acceptanceCriteria String         @default("")
  figmaUrl           String?
  /// Design is ready for implementation (not just linked)
  figmaReady         Boolean        @default(false)
  /// Figma file name, reported by the plugin
  figmaFile          String?
  /// Figma page name, reported by the plugin
  figmaPage          String?
  /// Figma frame/node name, reported by the plugin
  figmaFrame         String?
  githubIssueUrl     String?
  githubPrUrl        String?
  /// Related internal doc paths (e.g. knowledge/engineering.md)
  internalDocPaths   String[]       @default([])
  /// Explicit API / backend readiness for this task
  apiReady           Boolean        @default(false)
  designLinked       Boolean        @default(false)
  acPresent          Boolean        @default(false)
  rulesPresent       Boolean        @default(false)
  requirementPresent Boolean        @default(false)
  readinessScore     Int            @default(0)
  readinessNotes     String         @default("")
  /// Sprint the card is committed to. Null = not in any sprint (backlog).
  sprintId           String?
  /// Fibonacci-scale estimate. Null when the team sizes by card count instead.
  storyPoints        Int?
  /// Man hours the card was estimated at. Kept alongside storyPoints: points
  /// drive velocity, hours answer "can this person fit it in the sprint".
  estimateHours      Float?
  /// Man hours actually spent. Derived, never typed: commit sessions when the
  /// card has a merged PR, otherwise capped time in `working`.
  actualHours        Float?
  /// How actualHours was arrived at — "commits" | "status". Null on legacy rows
  /// entered by hand before the field became derived.
  actualHoursSource  String?
  actualHoursComputedAt DateTime?
  engineStatus       String?
  lastContextRunId   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  team          Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy     User                @relation("TaskCreator", fields: [createdById], references: [id])
  dependsOn     TaskDependency[]    @relation("DependentTask")
  dependedBy    TaskDependency[]    @relation("DependencyTask")
  contextRuns   ContextRun[]
  decisions     DecisionLog[]
  notifications Notification[]
  handoffDocs   TaskHandoff[]
  statusHistory TaskStatusHistory[]
  sprint        Sprint?             @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  scopeChanges  SprintScopeChange[]
  parent        Task?               @relation("TaskSubTasks", fields: [parentId], references: [id], onDelete: SetNull)
  subTasks      Task[]              @relation("TaskSubTasks")

  @@index([parentId])
  @@index([teamId, status])
  @@index([assigneeId])
  @@index([teamId, priority])
  @@index([projectId, status])
  @@index([sprintId])
  @@unique([projectId, taskNumber])
}

model DecisionLog {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  decision  String
  rationale String   @default("")
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model TaskDependency {
  id           String   @id @default(cuid())
  dependentId  String
  dependencyId String
  source       String   @default("manual") // manual | engine
  createdAt    DateTime @default(now())
  dependent    Task     @relation("DependentTask", fields: [dependentId], references: [id], onDelete: Cascade)
  dependency   Task     @relation("DependencyTask", fields: [dependencyId], references: [id], onDelete: Cascade)

  @@unique([dependentId, dependencyId])
}

model Notification {
  id        String           @id @default(cuid())
  teamId    String
  /// Project the notification belongs to — filters out people who left the project.
  projectId String
  /**
   * Recipient.
   */
  userId    String
  taskId    String?
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([teamId])
  @@index([projectId])
}

model TeamDoc {
  id        String    @id @default(cuid())
  teamId    String
  projectId String
  /**
   * Stable identifier used as DocChunk.sourcePath, e.g. "coupon.md".
   */
  path      String
  title     String?
  content   String
  source    DocSource @default(upload)
  sizeBytes Int
  indexedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([teamId])
}

model DocChunk {
  id         String                       @id @default(cuid())
  teamId     String
  projectId  String
  sourcePath String
  content    String
  chunkIndex Int
  metadata   Json?
  // Stored via raw SQL as vector(1536); Prisma keeps a float array mirror for upserts in app layer.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  team       Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project    Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // HNSW index on `embedding` (vector_cosine_ops) lives in migration
  // 20260830100000_docchunk_hnsw_index — Prisma cannot express it on an
  // Unsupported() column. Keep it when squashing migrations.
  @@unique([projectId, sourcePath, chunkIndex])
  @@index([teamId])
}

model ContextRun {
  id           String   @id @default(cuid())
  teamId       String
  projectId    String
  taskId       String?
  query        String
  contextPack  Json
  /**
   * Parsed Claude analysis — replayed by the cascade so re-evaluation needs no API call.
   */
  analysis     Json?
  claudeRaw    Json?
  engineOutput Json?
  error        String?
  createdAt    DateTime @default(now())
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([teamId, taskId])
  @@index([projectId])
}

model TaskHandoff {
  id        String   @id @default(cuid())
  taskId    String
  /**
   * e.g. "dev", "design", "qa"
   */
  role      String
  title     String
  /**
   * Markdown body
   */
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, role])
  @@index([taskId])
}

model IntegrationCredential {
  id        String   @id @default(cuid())
  teamId    String
  projectId String
  provider  String // github | figma
  payload   String // encrypted JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, provider])
}

/// Coarse grouping of TaskStatus used by every flow metric. Kept separate from
/// the status itself so statuses can be renamed/added without breaking history.
enum StatusCategory {
  backlog
  active
  waiting
  done
}

/// Append-only log of every status transition. This is the single source the
/// flow metrics (cycle time, time in status, WIP age, rework) are derived from
/// — nothing here is ever updated or recomputed after the fact.
model TaskStatusHistory {
  id          String         @id @default(cuid())
  taskId      String
  /// Null on the very first row (task creation).
  fromStatus  TaskStatus?
  toStatus    TaskStatus
  /// Category of `toStatus` at the time of writing — frozen so a later change
  /// to the status→category mapping cannot rewrite historical metrics.
  category    StatusCategory
  changedAt   DateTime       @default(now())
  /// Null when the engine, a webhook or the context pipeline made the change.
  changedById String?
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy   User?          @relation("StatusChangeAuthor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([taskId, changedAt])
}

enum ScopeChangeAction {
  added
  removed
}

/// A fixed time-box a project commits work into. Length is meant to stay
/// constant across sprints so the numbers can be compared at all.
model Sprint {
  id              String    @id @default(cuid())
  projectId       String
  name            String
  /// What the sprint is for, in one sentence. Set before cards are picked.
  goal            String    @default("")
  /// The planned time-box — also the x-axis of the burndown.
  startAt         DateTime
  endAt           DateTime
  /// Frozen at kick-off from the cards in scope at that moment. Never
  /// recomputed: comparing it to today's scope is what exposes scope creep.
  committedPoints Int?
  /// Kick-off. Null while the sprint is still being planned — moving cards in
  /// and out before this point is planning, not scope change, so it is not logged.
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  scopeChanges SprintScopeChange[]

  @@index([projectId, startAt])
}

/// Every card that entered or left a *started* sprint. Append-only, and the
/// reason the burndown can draw a scope line instead of silently re-baselining.
model SprintScopeChange {
  id        String            @id @default(cuid())
  sprintId  String
  taskId    String
  action    ScopeChangeAction
  /// Points the card carried at the moment it moved — frozen, since a later
  /// re-estimate must not rewrite what the sprint looked like back then.
  points    Int               @default(0)
  changedAt DateTime          @default(now())
  sprint    Sprint            @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([sprintId, changedAt])
}

/// One row per status per project per day — the Cumulative Flow Diagram reads
/// from here instead of replaying the whole transition log on every page view.
/// Written by a daily job; re-running it for the same day overwrites in place.
model FlowSnapshot {
  snapshotDate DateTime
  projectId    String
  status       TaskStatus
  taskCount    Int
  createdAt    DateTime   @default(now())
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([snapshotDate, projectId, status])
  @@index([projectId, snapshotDate])
}
